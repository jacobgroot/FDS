    "ax.set_xlabel(\"Climate bigram occurrences per speech\")\n",
    "ax.set_ylabel(\"Climate-flagged sentences per speech (BERT)\")\n",
    "ax.set_title(f\"Speech-level agreement (Spearman ρ = {rho:.2f})\")\n",
    "plt.show()"
