   "source": [
    "# Create a column for each bigram\n",
    "lemmatized_tokens = df_bigram_frequency['lemmatization']\n",
    "\n",
    "for bigram in re_bigrams:\n",
    "    new_column = 'token_' + \"_\".join(bigram) + '_count'\n",
    "    new_count = sum(1 for b in make_bigrams(lemmatized_tokens) if b == bigram)\n",
    "    df_bigram_frequency[new_column] = new_count\n",
    "\n",
    "df_bigram_frequency[df_bigram_frequency['has_renewable_energy']>0].sample(10)"
   ]
