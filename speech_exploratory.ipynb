    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "from scipy.stats import spearmanr\n",
    "\n",
    "# ---------- settings (change the names if your columns are called differently) ----------\n",
    "CSV        = \"data/input_model.csv\"\n",
    "TARGET     = \"log_share_co2\"\n",
    "CONTROLS   = [\"log_gdp\", \"vulnerability_score\"]\n",
    "BIGRAM_COL = \"climate_change_1000_rate\"          # bigram rate per 1,000 tokens\n",
    "BERT_COL   = \"climate_sentence_ratio_BERT\"       # share of sentences flagged by ClimateBERT\n",
    "C_BIGRAM   = \"#dd9152\"                           # orange, sampled from Fig. 3/4\n",
    "C_BERT     = \"#6752dd\"                           # purple/blue, sampled from Fig. 3/4\n",
    "N_LABELS   = 3                                   # label the N most extreme countries on x and on y\n",
    "OUT        = \"plots/climate_vs_share.pdf\"\n",
    "\n",
    "# ---------- data: same sample as the regressions, then one point per country ----------\n",
    "df = pd.read_csv(CSV)\n",
    "d = df.dropna(subset=[TARGET] + CONTROLS + [BIGRAM_COL, BERT_COL])\n",
    "c = d.groupby(\"country\")[[TARGET, BIGRAM_COL, BERT_COL]].mean()      # country averages (1995-2022)\n",
    "print(f\"{len(d)} country-years, {len(c)} countries\")\n",
    "\n",
    "# ---------- plot ----------\n",
    "plt.rcParams.update({\"font.size\": 7, \"axes.labelsize\": 7, \"axes.titlesize\": 7.5,\n",
    "                     \"xtick.labelsize\": 6.5, \"ytick.labelsize\": 6.5})\n",
    "fig, axes = plt.subplots(1, 2, figsize=(4.8, 2.4), sharey=True)\n",
    "\n",
    "panels = [(BIGRAM_COL, C_BIGRAM, \"(a) Bigram matching\", \"Bigram rate (per 1,000 tokens)\"),\n",
    "          (BERT_COL,   C_BERT,   \"(b) ClimateBERT\",     \"Share of sentences flagged by ClimateBERT\")]\n",
    "\n",
    "for ax, (col, colour, title, xlabel) in zip(axes, panels):\n",
    "    x, y = c[col], c[TARGET]\n",
    "    ax.scatter(x, y, s=9, color=colour, alpha=0.65, linewidths=0)\n",
    "    slope, intercept = np.polyfit(x, y, 1)                             # simple line through the country means\n",
    "    xs = np.linspace(x.min(), x.max(), 100)\n",
    "    ax.plot(xs, intercept + slope * xs, color=colour, lw=1.2)\n",
    "    rho, _ = spearmanr(x, y)\n",
    "    ax.text(0.97, 0.96, f\"Spearman $\\\\rho$ = {rho:.2f}\\n$n$ = {len(c)} countries\",\n",
    "            transform=ax.transAxes, ha=\"right\", va=\"top\", fontsize=6.5)\n",
    "    # label the most extreme countries (ISO codes)\n",
    "    extreme = list(x.nlargest(N_LABELS).index) + list(y.nlargest(N_LABELS).index)\n",
    "    for iso in dict.fromkeys(extreme):\n",
    "        ax.annotate(iso, (x[iso], y[iso]), xytext=(2, 2), textcoords=\"offset points\", fontsize=5.5)\n",
    "    ax.set_title(title, loc=\"left\")\n",
    "    ax.set_xlabel(xlabel)\n",
    "    ax.grid(alpha=0.25, lw=0.4)\n",
    "    ax.spines[[\"top\", \"right\"]].set_visible(False)\n",
    "\n",
    "axes[0].set_ylabel(\"Mean log share of global CO2 emissions\")\n",
    "fig.tight_layout()\n",
    "fig.savefig(OUT, bbox_inches=\"tight\")\n",
    "fig.savefig(OUT.replace(\".pdf\", \".png\"), dpi=200, bbox_inches=\"tight\")   # quick preview\n",
    "plt.show()"
   ]
