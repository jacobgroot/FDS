   "source": [
    "### ngrams"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a1d38d4c",
   "metadata": {},
   "source": [
    "In this section the objective is to determine the appereances of key words in each speech using ngrams."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 95,
   "id": "686f0f51",
   "metadata": {},
   "outputs": [],
   "source": [
    "df_ngrams = df_speeches.copy()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 96,
   "id": "c30972f9",
   "metadata": {},
   "outputs": [],
   "source": [
