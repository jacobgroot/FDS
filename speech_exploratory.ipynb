    "df_input = pd.read_csv('data/input_model.csv').set_index(['year','country'])\n",
    "BERT = df_input[\"climate_sentence_ratio_BERT\"]\n",
    "BERT_c = BERT.apply(lambda x: 1 if x > 0 else 0)\n",
    "BERT = BERT.groupby(BERT.index.get_level_values('year')).mean()\n",
    "BERT = BERT\n",
    "\n",
    "# Bigrams\n",
    "bigrams = {\n",
    "    # Energy\n",
    "    ('renewable', 'energy'),('energy', 'resource'),('energy', 'crisis'),\n",
    "    ('energy', 'source'),('clean', 'energy'),('sustainable', 'energy'),\n",
    "    # Climate\n",
    "    ('climate', 'change'),('climate', 'crisis'),\n",
    "    # Carbon\n",
    "    ('carbon','dioxide'),('carbon','emission'),\n",
    "    # Other\n",
    "    ('global','warming'),('carbon','dioxide'),('extreme','weather'),\n",
    "    ('greenhouse','gas'),('greenhouse','gases'),('natural','disasters'),\n",
    "    ('fossil','fuels'),('gas', 'emission'),\n",
    "    # Natural\n",
    "    ('natural', 'resource'),('natural', 'disaster')\n",
    "   }\n",
    "\n",
    "# def count_terms(tokens):\n",
    "#     uni = sum(1 for u in tokens if u in unigrams)\n",
    "#     bi = sum(1 for b in make_bigrams(tokens) if b in bigrams)\n",
    "#     return pd.Series({'unigram_count':uni, 'bigram_count':bi})\n",
    "\n",
    "# df_ngrams[['unigram_count','bigram_count']]= df_ngrams['lemmatization'].progress_apply(count_terms)\n",
    "\n",
    "# Determine if a speech has or not unigrams or bigrams\n",
    "df_ngrams['has_unigram'] = df_ngrams['unigram_count'].apply(lambda x: 1 if x > 0 else 0)\n",
    "df_ngrams['has_bigram'] = df_ngrams['bigram_count'].apply(lambda x: 1 if x > 0 else 0)\n",
    "df_ngrams['unigram_rate'] = df_ngrams['unigram_count']/df_ngrams['tokens_length']*1000\n",
    "df_ngrams['bigram_rate'] = df_ngrams['bigram_count']/df_ngrams['tokens_length']*1000\n",
    "# Option A mean of ratios\n",
    "yearly_A = df_ngrams.groupby('year')[['unigram_rate','bigram_rate']].mean()\n",
    "\n",
    "# Option general proportion\n",
    "yearly_B = df_ngrams.groupby('year')[['unigram_count','bigram_count','tokens_length']].sum()\n",
    "yearly_B['yearly_unigram_rate'] = yearly_B['unigram_count']/yearly_B['tokens_length']*1000\n",
    "yearly_B['yearly_bigram_rate'] = yearly_B['bigram_count']/yearly_B['tokens_length']*1000\n",
    "\n",
    "# Option to count countries that incorporated terms in their speeches\n",
    "yearly_C = df_ngrams.groupby('year')[['has_unigram','has_bigram']].sum()\n",
    "\n",
    "# 1. Initialize the figure and primary axis\n",
    "fig, ax = plt.subplots(figsize=(10, 5))\n",
    "\n",
    "# 2. Create secondary y-axis sharing the same x-axis\n",
    "ax2 = ax.twinx()\n",
    "\n",
    "# 3. Left axis: Word-level keyword rates (Unigrams & Bigrams)\n",
    "line1 = ax.plot(\n",
    "    yearly_B.index,\n",
    "    yearly_B['yearly_unigram_rate'],\n",
    "    color=\"#B08F4C\",\n",
    "    linewidth=2,\n",
    "    label='Unigram rate',\n",
    ")\n",
    "line2 = ax.plot(\n",
    "    yearly_B.index,\n",
    "    yearly_B['yearly_bigram_rate'],\n",
    "    color=\"#DD9152\",\n",
    "    linewidth=2,\n",
    "    label='Bigram rate',\n",
    ")\n",
    "\n",
    "# 4. Right axis: Sentence-level transformer rate (ClimateBERT)\n",
    "line3 = ax2.plot(\n",
    "    yearly_B.index,\n",
    "    BERT,\n",
    "    color=\"#6752DD\",\n",
    "    linewidth=2,\n",
    "    label='climateBERT rate',\n",
    ")\n",
    "\n",
    "# Axis labels & title\n",
    "ax.set_xlabel('Year')\n",
    "ax.set_ylabel('KM ratio of climate change')\n",
    "ax2.set_ylabel(\n",
    "    'ClimateBERT sentence ratio of climate change',\n",
    "    color=\"#6752DD\",\n",
    ")\n",
    "ax.set_title('Mentions of climate change over time')\n",
    "\n",
    "# Style right axis ticks & spines to match BERT's color\n",
    "ax2.tick_params(axis='y', labelcolor=\"#6752DD\")\n",
    "ax2.spines['right'].set_color(\"#6752DD\")\n",
    "ax.spines['top'].set_visible(False)\n",
    "ax2.spines['top'].set_visible(False)\n",
    "\n",
    "# Grid only on primary axis to avoid conflicting gridlines\n",
    "ax.grid(True, alpha=0.3)\n",
    "ax2.grid(False)\n",
    "\n",
    "# Combine lines and labels from both axes into a single legend\n",
    "lines = line1 + line2 + line3\n",
    "labels = [l.get_label() for l in lines]\n",
    "ax.legend(lines, labels, loc='upper left', frameon=True)\n",
    "\n",
    "plt.tight_layout()\n",
    "# save as vector image\n",
    "plt.savefig(\"plots/climate_change_mentions_over_time.pdf\", bbox_inches=\"tight\")\n",
    "# plt.savefig(\"plots/climate_change_mentions_over_time.png\")"
